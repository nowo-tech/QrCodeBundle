<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}QR Code Bundle Demo{% endblock %}</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { background: #f5f7fb; }
        .qr-demo-shell { max-width: 920px; }
        .qr-demo-card {
            border: 1px solid #e9edf5;
            border-radius: 16px;
            box-shadow: 0 8px 30px rgba(17, 24, 39, 0.06);
        }
        .qr-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
            gap: 1.25rem;
        }
        .qr-cell {
            background: #fff;
            border: 1px solid #e9edf5;
            border-radius: 12px;
            padding: 1rem;
            text-align: center;
        }
        .qr-cell img { max-width: 100%; height: auto; image-rendering: pixelated; }
        .qr-cell .label { font-size: .8rem; color: #6b7280; margin-top: .5rem; }
        .qr-demo-nav .nav-link.active { color: #fff; }
    </style>
    {% block stylesheets %}{% endblock %}
</head>
<body>
    <nav class="navbar navbar-dark bg-dark mb-4">
        <div class="container">
            <a class="navbar-brand" href="{{ path('app_demo_index') }}">QR Code Bundle Demo</a>
            {% set _route = app.request.attributes.get('_route')|default('') %}
            <ul class="navbar-nav flex-row gap-3 me-auto ms-3 qr-demo-nav">
                <li class="nav-item"><a class="nav-link{{ _route == 'app_demo_index' ? ' active' }}" href="{{ path('app_demo_index') }}">QR codes</a></li>
                {% if app.environment != 'prod' %}
                    <li class="nav-item"><a class="nav-link{{ _route starts with 'nowo_qr_code_admin' ? ' active' }}" href="{{ path('nowo_qr_code_admin_index') }}" data-testid="nav-admin">Profiles admin</a></li>
                {% endif %}
            </ul>
            <span class="navbar-text text-white-50 small">Symfony 8 · FrankenPHP</span>
        </div>
    </nav>
    {% block body %}{% endblock %}
    {% block javascripts %}{% endblock %}
</body>
</html>
