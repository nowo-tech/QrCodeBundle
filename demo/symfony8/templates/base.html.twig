{#- REQ-DEMO-014: the demo runs inside UiKit's shared demo platform shell. This file only declares the demo; it is also the
    host layout of the QR profile admin pages (nowo_ui_kit.layouts). The profile admin exists in the dev / test demo only. -#}
{% extends '@NowoUiKit/demo_platform/layout.html.twig' %}
{% set _admin = app.environment != 'prod' ? [{label: 'Profiles admin', route: 'nowo_qr_code_admin_index', active: ['nowo_qr_code_admin_*'], section: 'QR Code', testid: 'nav-admin'}] : [] %}
{% set nowo_ui_demo_platform = {
    bundle: 'QR Code',
    home_route: 'app_demo_index',
    repository: 'https://github.com/nowo-tech/QrCodeBundle',
    translation_domain: false,
    nav: [{label: 'QR codes', route: 'app_demo_index', section: 'QR Code'}]|merge(_admin),
} %}
{% block nowo_ui_document_title %}{% block title %}QR Code Bundle Demo{% endblock %}{% endblock %}

{% block nowo_ui_content %}{% block body %}{% endblock %}{% endblock %}
