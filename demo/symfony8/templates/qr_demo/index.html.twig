{% extends 'base.html.twig' %}

{% block nowo_ui_page_header %}
    {{ include(nowo_ui_partial('page_header'), {
        title: 'QR Code Bundle',
        intro: 'PNG data URIs via QrCodeService, Twig helpers qr_code_data_uri / qr_code_for_url, and <twig:NowoQrCode>. Profiles: default (300px) and compact (128px, allowlist example.com).',
    }) }}
{% endblock %}

{% block body %}
    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Twig functions', kind: 'table'} %}
        {% block section_body %}
            <table class="nowo-ui-data-table">
                <thead>
                    <tr><th scope="col">QR code</th><th scope="col">Call</th></tr>
                </thead>
                <tbody>
                    <tr>
                        <td data-testid="qr-cell"><img src="{{ qr_code_data_uri('EVENT-42') }}" alt="default profile QR"></td>
                        <td><code class="nowo-ui-code">qr_code_data_uri('EVENT-42')</code></td>
                    </tr>
                    <tr>
                        <td data-testid="qr-cell"><img src="{{ qr_code_data_uri('EVENT-42', 'compact') }}" alt="compact profile QR"></td>
                        <td><code class="nowo-ui-code">qr_code_data_uri('EVENT-42', 'compact')</code></td>
                    </tr>
                    <tr>
                        <td data-testid="qr-cell"><img src="{{ qr_code_for_url(sample_url, 'compact') }}" alt="URL QR compact"></td>
                        <td><code class="nowo-ui-code">qr_code_for_url(url, 'compact')</code></td>
                    </tr>
                </tbody>
            </table>
        {% endblock %}
    {% endembed %}

    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Twig UX component', kind: 'table'} %}
        {% block section_body %}
            <table class="nowo-ui-data-table">
                <thead>
                    <tr><th scope="col">QR code</th><th scope="col">Call</th></tr>
                </thead>
                <tbody>
                    <tr>
                        <td data-testid="qr-cell"><twig:NowoQrCode content="Hello" class="qr" /></td>
                        <td><code class="nowo-ui-code">&lt;twig:NowoQrCode content="Hello" /&gt;</code></td>
                    </tr>
                    <tr>
                        <td data-testid="qr-cell"><twig:NowoQrCode url="{{ sample_url }}" profile="compact" /></td>
                        <td><code class="nowo-ui-code">url + profile="compact"</code></td>
                    </tr>
                </tbody>
            </table>
        {% endblock %}
    {% endembed %}

    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'PHP QrCodeService', kind: 'table'} %}
        {% block section_body %}
            <table class="nowo-ui-data-table">
                <thead>
                    <tr><th scope="col">QR code</th><th scope="col">Call</th></tr>
                </thead>
                <tbody>
                    <tr>
                        <td data-testid="qr-cell"><img src="{{ php_data_uri }}" alt="PHP createDataUri"></td>
                        <td><code class="nowo-ui-code">createDataUri(…)</code></td>
                    </tr>
                    <tr>
                        <td data-testid="qr-cell"><img src="{{ php_url_uri }}" alt="PHP createDataUriForUrl"></td>
                        <td><code class="nowo-ui-code">createDataUriForUrl(…, 'compact')</code></td>
                    </tr>
                </tbody>
            </table>
        {% endblock %}
    {% endembed %}

    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Configuration', kind: 'detail'} %}
        {% block section_body %}
            <p>
                Profiles live in <code class="nowo-ui-code">config/packages/nowo_qr_code.yaml</code>. In the dev demo they are also stored in the database
                (seeded by <code class="nowo-ui-code">app:demo:setup</code>) and managed in the profile admin.
            </p>
            <p><a class="nowo-ui-btn nowo-ui-btn--outline nowo-ui-btn--sm" href="https://github.com/nowo-tech/QrCodeBundle/blob/main/docs/CONFIGURATION.md">Configuration reference</a></p>
        {% endblock %}
    {% endembed %}
{% endblock %}
