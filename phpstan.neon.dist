# PHPStan configuration for QR Code Bundle.
# Compatible with PHP 8.1+ and Symfony 7.x / 8.x
# Extensions (phpstan-symfony, phpstan-phpunit, phpstan-frankenphp extension)
# are auto-included via phpstan/extension-installer.

parameters:
    level: 8
    paths:
        - src
        - tests
    excludePaths:
        - demo/*
        - vendor/*
    reportUnmatchedIgnoredErrors: false
    treatPhpDocTypesAsCertain: false
    ignoreErrors: []

includes:
    - vendor/nowo-tech/phpstan-frankenphp/ruleset-classic.neon
    - vendor/nowo-tech/phpstan-frankenphp/ruleset-worker.neon
