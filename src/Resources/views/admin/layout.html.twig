<!DOCTYPE html>
<html lang="{{ app.request.locale|default('en') }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}QR Code profiles{% endblock %}</title>
    <style>
        :root {
            --qr-bg: #f4f6f8;
            --qr-card: #fff;
            --qr-text: #1f2937;
            --qr-muted: #6b7280;
            --qr-border: #d1d5db;
            --qr-primary: #1d4ed8;
            --qr-danger: #b91c1c;
            --qr-warn-bg: #fffbeb;
            --qr-warn-border: #f59e0b;
        }
        * { box-sizing: border-box; }
        body {
            margin: 0;
            font-family: "Segoe UI", system-ui, sans-serif;
            background: var(--qr-bg);
            color: var(--qr-text);
            line-height: 1.45;
        }
        .qr-wrap { max-width: 960px; margin: 0 auto; padding: 1.5rem; }
        .qr-header { display: flex; justify-content: space-between; gap: 1rem; align-items: flex-start; margin-bottom: 1rem; }
        .qr-header h1 { margin: 0 0 .25rem; font-size: 1.5rem; }
        .qr-lead { margin: 0; color: var(--qr-muted); }
        .qr-muted { color: var(--qr-muted); font-size: .875rem; }
        .qr-toolbar { display: flex; flex-wrap: wrap; gap: .75rem; align-items: center; margin-bottom: 1rem; }
        .qr-btn, button.qr-btn {
            display: inline-block;
            border: 1px solid var(--qr-border);
            background: var(--qr-card);
            color: var(--qr-text);
            padding: .45rem .8rem;
            border-radius: .4rem;
            text-decoration: none;
            cursor: pointer;
            font: inherit;
        }
        .qr-btn-primary { background: var(--qr-primary); border-color: var(--qr-primary); color: #fff; }
        .qr-table { width: 100%; border-collapse: collapse; background: var(--qr-card); border: 1px solid var(--qr-border); border-radius: .5rem; overflow: hidden; }
        .qr-table th, .qr-table td { border-bottom: 1px solid var(--qr-border); padding: .65rem .75rem; text-align: left; vertical-align: top; }
        .qr-table th { background: #eef2f7; font-size: .85rem; }
        .qr-actions { display: flex; gap: .75rem; align-items: center; white-space: nowrap; }
        .qr-actions form { margin: 0; }
        .qr-link-danger { background: none; border: 0; color: var(--qr-danger); cursor: pointer; padding: 0; font: inherit; }
        .qr-alert { padding: .75rem 1rem; border-radius: .4rem; margin-bottom: 1rem; }
        .qr-alert-warn { background: var(--qr-warn-bg); border: 1px solid var(--qr-warn-border); }
        .qr-alert-success { background: #ecfdf5; border: 1px solid #34d399; }
        .qr-alert-error { background: #fef2f2; border: 1px solid #f87171; }
        .qr-form { background: var(--qr-card); border: 1px solid var(--qr-border); border-radius: .5rem; padding: 1rem 1.25rem; max-width: 36rem; }
        .qr-form label { display: block; margin-top: .75rem; font-weight: 600; }
        .qr-form input[type="text"], .qr-form input[type="number"], .qr-form select, .qr-form textarea {
            width: 100%; margin-top: .25rem; padding: .45rem .55rem; border: 1px solid var(--qr-border); border-radius: .35rem; font: inherit;
        }
        .qr-form .form-help, .qr-form .help-text { color: var(--qr-muted); font-size: .85rem; }
        .qr-form-actions { display: flex; gap: .75rem; margin-top: 1.25rem; }
        .qr-badge { display: inline-block; border-radius: 999px; padding: .15rem .55rem; font-size: .75rem; background: #e0e7ff; color: #3730a3; }
        code { font-size: .9em; }
    </style>
</head>
<body>
    <div class="qr-wrap">
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="qr-alert qr-alert-{{ label == 'success' ? 'success' : (label == 'error' ? 'error' : 'warn') }}" role="alert">{{ message }}</div>
            {% endfor %}
        {% endfor %}
        {% block body %}{% endblock %}
    </div>
</body>
</html>
