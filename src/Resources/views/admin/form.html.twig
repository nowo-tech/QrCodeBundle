{#
  QR profile create / edit (REQ-UI-003): UiKit form scaffold. Variable: page (View\FormPage from
  QrCodePageFactory::form(): header new_title / edit_title (intro = profile name on edit) with a back link to the list;
  form = QrCodeProfileConfigType; submit nowo_qr_code.admin.form.save; cancel = list; on edit the delete zone (POST +
  CSRF FormView behind a Confirm)). Also: profile, is_new, use_database_config.
  Data block filled: nowo_ui_form_body (database-config notice, then the REQ-TWIG-003 child loop).
#}
{% extends '@NowoUiKit/page/form.html.twig' %}
{% trans_default_domain 'NowoQrCodeBundle' %}

{% block nowo_ui_form_body %}
    {% if not use_database_config|default(false) %}
        <div class="{{ nowo_ui_class('flash_warning', page.bundle) }}" role="status" data-testid="qr-code-db-config-off">{{ 'nowo_qr_code.admin.form.db_config_off'|trans }}</div>
    {% endif %}
    {{ parent() }}
{% endblock %}
