{# Page shell (REQ-UI-001): extends configurable layout and stacks admin extras with parent(). #}
{% extends nowo_qr_code_layout_template|default('@NowoQrCodeBundle/admin/layout.html.twig') %}
{% import '@NowoUiKitBundle/macros/ui.html.twig' as ui %}
{% set _css_fw = nowo_qr_code_css_framework|default('custom') %}

{% block nowo_ui_flashes %}
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            {% set _flash_type = label == 'success' ? 'success' : (label == 'error' ? 'error' : 'warning') %}
            <div class="{{ ui.flash(_flash_type, _css_fw) }}" role="alert">{{ message }}</div>
        {% endfor %}
    {% endfor %}
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    {% block nowo_ui_styles %}
        <link rel="stylesheet" href="{{ asset('css/nowo-ui.css', 'nowo_ui_kit') }}">
    {% endblock %}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {% block nowo_ui_scripts %}{% endblock %}
{% endblock %}
