{#
  QR Code profiles (REQ-UI-003): UiKit list scaffold. Variable: page (View\ListPage from QrCodePageFactory::index():
  header nowo_qr_code.admin.index.title with the actions New profile and Import from YAML (POST + CSRF FormView);
  columns name, size, margin, error correction, URL allowlist; rows = list<QrCodeProfileConfig>; row actions Edit /
  Delete (POST + CSRF FormView behind a Confirm); Pagination (web_ui.list_page_size); EmptyState
  nowo_qr_code.admin.index.empty with New profile). Also: yaml_profiles (list<string>), use_database_config (bool).
  Data blocks filled: nowo_ui_list_filters (database-config notice + YAML baseline, then the default region),
  nowo_ui_list_row (cells).
#}
{% extends '@NowoUiKit/page/list.html.twig' %}
{% trans_default_domain 'NowoQrCodeBundle' %}

{% block nowo_ui_list_filters %}
    {% set _b = page.bundle %}
    {% if not use_database_config|default(false) %}
        <div class="{{ nowo_ui_class('flash_warning', _b) }}" role="status" data-testid="qr-code-db-config-off">{{ 'nowo_qr_code.admin.index.db_config_off'|trans }}</div>
    {% endif %}
    <p class="{{ nowo_ui_class('muted', _b) }} nowo-qr-code-yaml-baseline" data-testid="qr-code-yaml-baseline">
        {{ 'nowo_qr_code.admin.index.yaml_baseline'|trans }}
        {% for name in yaml_profiles|default([]) %}<code class="{{ nowo_ui_class('code', _b) }}">{{ name }}</code>{% if not loop.last %}, {% endif %}{% else %}—{% endfor %}
    </p>
    {{ parent() }}
{% endblock %}

{% block nowo_ui_list_row %}
    {% set _b = page.bundle %}
    {% set _cell = nowo_ui_class('table_cell', _b) %}
    <td class="{{ _cell }}" data-label="{{ 'nowo_qr_code.admin.columns.name'|trans }}" data-required="1">
        <code class="{{ nowo_ui_class('code', _b) }}">{{ row.name }}</code>
        {% if row.name in yaml_profiles|default([]) %}
            <span class="{{ nowo_ui_class('badge_info', _b) }}">{{ 'nowo_qr_code.admin.badge.overrides_yaml'|trans }}</span>
        {% else %}
            <span class="{{ nowo_ui_class('badge_neutral', _b) }}">{{ 'nowo_qr_code.admin.badge.db_only'|trans }}</span>
        {% endif %}
    </td>
    <td class="{{ _cell }} nowo-ui-cell--end" data-label="{{ 'nowo_qr_code.admin.columns.size'|trans }}">{{ row.size }}</td>
    <td class="{{ _cell }} nowo-ui-cell--end" data-label="{{ 'nowo_qr_code.admin.columns.margin'|trans }}" data-nowo-ui-priority="2">{{ row.margin }}</td>
    <td class="{{ _cell }}" data-label="{{ 'nowo_qr_code.admin.columns.error_correction'|trans }}" data-nowo-ui-priority="2">{{ ('nowo_qr_code.admin.error_correction.' ~ row.errorCorrection)|trans }}</td>
    <td class="{{ _cell }}" data-label="{{ 'nowo_qr_code.admin.columns.url_allowlist'|trans }}" data-nowo-ui-priority="3">
        {% if row.urlAllowlist is empty %}
            <span class="{{ nowo_ui_class('muted', _b) }}">{{ 'nowo_qr_code.admin.allowlist_any'|trans }}</span>
        {% else %}
            {% for pattern in row.urlAllowlist %}<code class="{{ nowo_ui_class('code', _b) }}">{{ pattern }}</code>{% if not loop.last %} {% endif %}{% endfor %}
        {% endif %}
    </td>
{% endblock %}
