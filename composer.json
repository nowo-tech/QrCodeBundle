{
    "name": "nowo-tech/qr-code-bundle",
    "description": "Symfony bundle to generate PNG QR codes as data URIs with optional URL safety policy.",
    "type": "symfony-bundle",
    "license": "MIT",
    "keywords": [
        "symfony",
        "symfony-bundle",
        "php",
        "frankenphp",
        "qr-code",
        "qr",
        "data-uri",
        "twig",
        "twig-component",
        "symfony-ux",
        "ux-toolkit"
    ],
    "homepage": "https://github.com/nowo-tech/QrCodeBundle",
    "support": {
        "issues": "https://github.com/nowo-tech/QrCodeBundle/issues",
        "source": "https://github.com/nowo-tech/QrCodeBundle"
    },
    "authors": [
        {
            "name": "H\u00e9ctor Franco Aceituno",
            "email": "hectorfranco@nowo.tech",
            "homepage": "https://github.com/HecFranco",
            "role": "Developer"
        },
        {
            "name": "Nowo.tech",
            "homepage": "https://nowo.tech"
        }
    ],
    "require": {
        "endroid/qr-code": "^6.0",
        "nowo-tech/form-kit-bundle": "^2.0",
        "nowo-tech/ui-kit-bundle": "^1.4",
        "php": ">=8.2 <8.6",
        "symfony/config": "^7.0 || ^8.0",
        "symfony/dependency-injection": "^7.0 || ^8.0",
        "symfony/http-kernel": "^7.0 || ^8.0",
        "symfony/twig-bundle": "^7.0 || ^8.0",
        "symfony/ux-twig-component": "^2.20 || ^3.0",
        "twig/extra-bundle": "^3.12",
        "twig/string-extra": "^3.12",
        "twig/twig": "^3.8 || ^4.0"
    },
    "require-dev": {
        "doctrine/doctrine-bundle": "^2.12 || ^3.0",
        "doctrine/orm": "^2.19 || ^3.0",
        "friendsofphp/php-cs-fixer": "^3.0",
        "nowo-tech/phpstan-frankenphp": "^1.0",
        "phpstan/extension-installer": "^1.0",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-symfony": "^2.0",
        "phpunit/phpunit": "^11.0",
        "rector/rector": "^2.0",
        "symfony/form": "^7.0 || ^8.0",
        "symfony/framework-bundle": "^7.0 || ^8.0",
        "symfony/security-core": "^7.0 || ^8.0",
        "symfony/validator": "^7.0 || ^8.0",
        "symfony/yaml": "^7.0 || ^8.0",
        "vincentlanglet/twig-cs-fixer": "^4.1"
    },
    "autoload": {
        "psr-4": {
            "Nowo\\QrCodeBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Nowo\\QrCodeBundle\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "phpstan/extension-installer": true,
            "rector/rector": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "archive": {
        "exclude": [
            "/demo",
            "/.cursor"
        ]
    },
    "scripts": {
        "test": "@php vendor/bin/phpunit --color=always",
        "test-coverage": "@php vendor/bin/phpunit --color=always --coverage-html coverage --coverage-clover coverage.xml --coverage-text",
        "cs-check": "@php vendor/bin/php-cs-fixer fix --dry-run --diff",
        "cs-fix": "@php vendor/bin/php-cs-fixer fix",
        "rector": "@php vendor/bin/rector process",
        "rector-dry": "@php vendor/bin/rector process --dry-run --no-progress-bar",
        "phpstan": "@php vendor/bin/phpstan analyse --memory-limit=512M",
        "qa": [
            "@cs-check",
            "@phpstan",
            "@test"
        ],
        "twig:lint": "twig-cs-fixer lint --config=.twig-cs-fixer.php",
        "twig:fix": "twig-cs-fixer fix --config=.twig-cs-fixer.php",
        "twig:fix:check": "twig-cs-fixer lint --config=.twig-cs-fixer.php --fix"
    },
    "suggest": {
        "ext-gd": "Required by endroid/qr-code for PNG rendering",
        "doctrine/orm": "Required when nowo_qr_code.use_database_config is true (DB profile overrides + admin CRUD)",
        "doctrine/doctrine-bundle": "Required when nowo_qr_code.use_database_config is true",
        "symfony/form": "Required for the optional /admin/qr-code-profiles CRUD",
        "symfony/validator": "Recommended for admin form constraints",
        "symfony/security-bundle": "Recommended to protect admin CRUD via security.access_roles",
        "symfony/ux-toolkit": "Optional design-system toolkit (PHP 8.4+); NowoQrCode follows Toolkit @prop documentation conventions and works alongside Shadcn kit components"
    }
}
